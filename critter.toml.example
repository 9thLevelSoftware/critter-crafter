# Copy to critter.toml (gitignored). Paths are local; do not commit a glTF-Validator binary.

[paths]
# asset_archive = "D:\\synaptic-sea-asset-archive"

[tools]
# blender = "C:\\Program Files\\Blender Foundation\\Blender 5.2\\blender.exe"
# unity = "F:\\Unity\\6000.6.0f1\\Editor\\Unity.exe"

# Khronos glTF-Validator native CLI (https://github.com/KhronosGroup/glTF-Validator/releases).
# Do not use the npm package. Unpack the platform archive and point at the executable.
# Pin: 2.0.0-dev.3.10
#   Windows: gltf_validator-2.0.0-dev.3.10-win64.zip
#     exe SHA-256: 4388a152ff90b68c6430ae03862e05e257a9d50a500ed7d0eb1cd420dc75ff96
#   Linux:   gltf_validator-2.0.0-dev.3.10-linux64.tar.xz
#   macOS:   gltf_validator-2.0.0-dev.3.10-macos64.tar.xz
# Hash the unpacked executable (Get-FileHash / sha256sum), not the zip.
# The validator runs only when gltf_validator_sha256 matches the file. No PATH lookup.
# gltf_validator = "tools/gltf_validator.exe"
# gltf_validator_sha256 = "4388a152ff90b68c6430ae03862e05e257a9d50a500ed7d0eb1cd420dc75ff96"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://9thlevelsoftware.github.io/critter-crafter/schemas/binding_profile_registry.v3.schema.json",
  "title": "binding_profile_registry.v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_profile_id", "binding_profile_version", "binding_profile_hash"],
      "properties": {
        "binding_profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "binding_profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "binding_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }}
  }
}

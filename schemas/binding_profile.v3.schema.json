{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://9thlevelsoftware.github.io/critter-crafter/schemas/binding_profile.v3.schema.json",
  "title": "binding_profile.v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_profile_id", "binding_profile_version", "template", "joint_order", "bone_fractions", "girth_ratio", "joints", "landmarks"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "binding_profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "binding_profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "template": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "joint_order": {"type": "array", "minItems": 1, "maxItems": 120, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "bone_fractions": {"type": "array", "minItems": 1, "maxItems": 120, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}},
    "girth_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "joints": {
      "type": "array", "minItems": 1, "maxItems": 120,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["joint_id", "parent_joint", "canonical_position_n", "canonical_rotation_xyzw", "primary_axis", "secondary_axis", "limits_deg"],
        "properties": {
          "joint_id": {"$ref": "#/$defs/name"},
          "parent_joint": {"type": "string"},
          "canonical_position_n": {"$ref": "#/$defs/vec3"},
          "canonical_rotation_xyzw": {"$ref": "#/$defs/quat"},
          "primary_axis": {"$ref": "#/$defs/vec3"},
          "secondary_axis": {"$ref": "#/$defs/vec3"},
          "limits_deg": {
            "type": "object", "additionalProperties": false,
            "required": ["swing_x", "swing_y", "twist"],
            "properties": {
              "swing_x": {"$ref": "#/$defs/range"},
              "swing_y": {"$ref": "#/$defs/range"},
              "twist": {"$ref": "#/$defs/range"}
            }
          }
        }
      }
    },
    "landmarks": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["landmark_id", "parent_joint", "position_n", "rotation_xyzw"],
        "properties": {
          "landmark_id": {"$ref": "#/$defs/name"},
          "parent_joint": {"$ref": "#/$defs/name"},
          "position_n": {"$ref": "#/$defs/vec3"},
          "rotation_xyzw": {"$ref": "#/$defs/quat"}
        }
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$"},
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "quat": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "range": {"type": "array", "items": {"type": "number", "minimum": -180, "maximum": 180}, "minItems": 2, "maxItems": 2}
  }
}

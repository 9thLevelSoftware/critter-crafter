{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://9thlevelsoftware.github.io/critter-crafter/schemas/gait_profiles.v3.schema.json",
  "title": "gait_profiles.v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gait_profiles"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "gait_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["hint", "frequency_hz", "amplitude_deg", "chain_lag_rad", "bob_m"],
      "properties": {
        "hint": {"enum": ["biped", "quadruped", "crawl", "drag", "slither"]},
        "frequency_hz": {"type": "number", "exclusiveMinimum": 0},
        "amplitude_deg": {"type": "number", "minimum": 0, "maximum": 180},
        "chain_lag_rad": {"type": "number", "minimum": 0},
        "bob_m": {"type": "number", "minimum": 0}
      }
    }}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://9thlevelsoftware.github.io/critter-crafter/schemas/pools.v2.schema.json",
  "title": "pools.v2.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "pools"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "pools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pool_id",
          "families",
          "skeleton_ids"
        ],
        "properties": {
          "pool_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skeleton_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      }
    }
  }
}
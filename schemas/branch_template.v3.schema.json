{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://9thlevelsoftware.github.io/critter-crafter/schemas/branch_template.v3.schema.json",
  "title": "branch_template.v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "chain_kind", "nominal_length_m", "bone_fractions"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "template_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "chain_kind": {"type": "string"},
    "nominal_length_m": {"type": "number", "exclusiveMinimum": 0},
    "bone_fractions": {"type": "array", "minItems": 1, "maxItems": 120, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}
  }
}

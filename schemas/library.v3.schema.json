{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://9thlevelsoftware.github.io/critter-crafter/schemas/library.v3.schema.json",
  "title": "library.v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_kind", "library_id", "version", "frame", "limits", "generator", "binding_profiles", "skeletons", "parts", "pools", "branch_templates", "gait_profiles"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "document_kind": {"const": "critter_library"},
    "library_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "frame": {"const": "gltf_rh_yup_zfwd_m"},
    "generator": {"type": "object", "additionalProperties": false, "required": ["algorithm", "rng"], "properties": {"algorithm": {"const": "cc-gen-3"}, "rng": {"const": "splitmix64"}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_triangles", "target_triangles", "max_bones", "max_parts", "max_influences", "min_length_scale_pct", "max_length_scale_pct", "girth_tolerance_pct"], "properties": {
      "max_triangles": {"const": 30000}, "target_triangles": {"type": "integer", "minimum": 1, "maximum": 30000},
      "max_bones": {"const": 120}, "max_parts": {"const": 16}, "max_influences": {"const": 4},
      "min_length_scale_pct": {"const": 80}, "max_length_scale_pct": {"const": 125}, "girth_tolerance_pct": {"const": 10}
    }},
    "binding_profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profile"}},
    "skeletons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/skeleton"}},
    "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}},
    "pools": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pool"}},
    "branch_templates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/template"}},
    "gait_profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gait"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "quat": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "transform": {"type": "object", "additionalProperties": false, "required": ["position_m", "rotation_xyzw"], "properties": {"position_m": {"$ref": "#/$defs/vec3"}, "rotation_xyzw": {"$ref": "#/$defs/quat"}}},
    "contact_schedule_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["contact_id", "branch_id", "contact_index", "kind", "phase_offset", "stance_fraction", "support"],
      "properties": {
        "contact_id": {"type": "string", "pattern": "^[^:]+:[0-9]+$"},
        "branch_id": {"type": "string", "minLength": 1},
        "contact_index": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["foot", "hand", "body", "sliding"]},
        "phase_offset": {"type": "number", "minimum": 0, "maximum": 1},
        "stance_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "support": {"type": "boolean"}
      }
    },
    "clip": {"type": "object", "additionalProperties": false, "required": ["name", "loop", "frames", "fps", "duration_s", "cadence_hz", "speed_mps", "stride_m", "playback", "support_policy", "contact_schedule", "nominal_speed_mps", "ground_offset_m"], "properties": {
      "name": {"type": "string"}, "loop": {"type": "boolean"}, "frames": {"type": "integer", "minimum": 1}, "fps": {"type": "number", "exclusiveMinimum": 0},
      "duration_s": {"type": "number", "minimum": 0}, "cadence_hz": {"type": "number", "minimum": 0}, "speed_mps": {"type": "number"},
      "stride_m": {"type": "number", "minimum": 0},
      "playback": {"type": "object", "additionalProperties": false, "required": ["wrap", "phase_range", "continuation", "rate_range"], "properties": {
        "wrap": {"enum": ["loop", "once"]}, "phase_range": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false, "minItems": 2, "maxItems": 2}, "continuation": {"type": "string"},
        "rate_range": {"const": [0.5, 1.5]}
      }},
      "support_policy": {"type": "object", "additionalProperties": false, "required": ["mode", "death_release_phase", "airborne_phases"], "properties": {
        "mode": {"type": "string"}, "death_release_phase": {"type": ["number", "null"]}, "airborne_phases": {"type": "array", "items": {"type": "number"}}
      }},
      "contact_schedule": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/contact_schedule_entry"}},
      "nominal_speed_mps": {"type": "number"}, "ground_offset_m": {"type": "number"}
    }},
    "asset": {"type": "object", "additionalProperties": false, "required": ["fbx", "glb"], "properties": {
      "fbx": {"type": "string"}, "glb": {"type": "string"}, "blend": {"type": "string"}, "motion": {"type": "string"},
      "assembled_glb": {"type": "string"}, "polish_fingerprint": {"type": "string"},
      "clips": {"type": "array", "items": {"$ref": "#/$defs/clip"}}, "triangles": {"type": "integer", "minimum": 0}
    }},
    "joint": {"type": "object", "additionalProperties": false, "required": ["joint_id", "parent_joint", "canonical_position_n", "canonical_rotation_xyzw", "primary_axis", "secondary_axis", "limits_deg"], "properties": {
      "joint_id": {"type": "string"}, "parent_joint": {"type": "string"}, "canonical_position_n": {"$ref": "#/$defs/vec3"},
      "canonical_rotation_xyzw": {"$ref": "#/$defs/quat"}, "primary_axis": {"$ref": "#/$defs/vec3"}, "secondary_axis": {"$ref": "#/$defs/vec3"},
      "limits_deg": {"type": "object", "additionalProperties": false, "required": ["swing_x", "swing_y", "twist"], "properties": {
        "swing_x": {"$ref": "#/$defs/range"}, "swing_y": {"$ref": "#/$defs/range"}, "twist": {"$ref": "#/$defs/range"}
      }}
    }},
    "range": {"type": "array", "items": {"type": "number", "minimum": -180, "maximum": 180}, "minItems": 2, "maxItems": 2},
    "bone": {"type": "object", "additionalProperties": false, "required": ["name", "parent", "head_m", "tail_m", "up_m"], "properties": {
      "name": {"type": "string"}, "parent": {"type": "string"}, "joint_id": {"type": "string"},
      "head_m": {"$ref": "#/$defs/vec3"}, "tail_m": {"$ref": "#/$defs/vec3"}, "up_m": {"$ref": "#/$defs/vec3"}
    }},
    "profile": {
      "type": "object",
      "required": ["binding_profile_id", "binding_profile_version", "binding_profile_hash", "template", "joint_order", "bone_fractions", "joints"],
      "properties": {
        "binding_profile_id": {"$ref": "#/$defs/id"}, "binding_profile_version": {"$ref": "#/$defs/version"},
        "binding_profile_hash": {"$ref": "#/$defs/hash"}, "template": {"$ref": "#/$defs/id"},
        "joint_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "bone_fractions": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
        "joints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/joint"}}
      }
    },
    "skeleton": {
      "type": "object",
      "required": ["skeleton_id", "family", "locomotion_hint", "status", "anatomy", "neutral_pose", "bones", "branches", "asset"],
      "properties": {
        "skeleton_id": {"$ref": "#/$defs/id"}, "family": {"type": "string"}, "locomotion_hint": {"type": "string"},
        "status": {"enum": ["draft", "approved", "rejected"]}, "anatomy": {"type": "object"}, "neutral_pose": {"type": "object"},
        "bones": {"type": "array", "minItems": 1, "maxItems": 120, "items": {"$ref": "#/$defs/bone"}},
        "branches": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "required": ["branch_id", "binding_profile_id", "binding_profile_version", "binding_profile_hash", "bone_names", "socket", "snap", "connector_interface"], "properties": {
          "branch_id": {"type": "string"}, "binding_profile_id": {"$ref": "#/$defs/id"}, "binding_profile_version": {"$ref": "#/$defs/version"}, "binding_profile_hash": {"$ref": "#/$defs/hash"},
          "bone_names": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "socket": {"$ref": "#/$defs/socket"}, "snap": {"$ref": "#/$defs/transform"}, "connector_interface": {"type": "object"}
        }}},
        "asset": {"$ref": "#/$defs/asset"}
      }
    },
    "socket": {"type": "object", "additionalProperties": false, "required": ["parent_joint", "position_m", "rotation_xyzw"], "properties": {"parent_joint": {"type": "string"}, "position_m": {"$ref": "#/$defs/vec3"}, "rotation_xyzw": {"$ref": "#/$defs/quat"}}},
    "part": {
      "type": "object",
      "required": ["part_id", "category", "template", "binding_profile_id", "binding_profile_version", "binding_profile_hash", "inventory_kind", "side", "status", "length_mm", "girth_mm", "max_triangles", "connector_interface", "asset"],
      "properties": {
        "part_id": {"type": "string"}, "category": {"type": "string"}, "template": {"type": "string"},
        "binding_profile_id": {"$ref": "#/$defs/id"}, "binding_profile_version": {"$ref": "#/$defs/version"}, "binding_profile_hash": {"$ref": "#/$defs/hash"},
        "inventory_kind": {"enum": ["production", "reference"]}, "side": {"enum": ["symmetric", "L", "R", "C"]},
        "status": {"enum": ["draft", "approved", "rejected", "reference"]}, "length_mm": {"type": "integer", "minimum": 1},
        "girth_mm": {"type": "integer", "minimum": 1}, "max_triangles": {"type": "integer", "minimum": 1, "maximum": 30000},
        "connector_interface": {"type": "object"}, "asset": {"$ref": "#/$defs/asset"}
      }
    },
    "pool": {"type": "object", "required": ["pool_id", "families", "skeleton_ids"], "properties": {"pool_id": {"$ref": "#/$defs/id"}, "families": {"type": "array"}, "skeleton_ids": {"type": "array"}}},
    "template": {"type": "object", "required": ["template_id", "chain_kind", "nominal_length_m", "bone_fractions"], "properties": {"template_id": {"$ref": "#/$defs/id"}, "chain_kind": {"type": "string"}, "nominal_length_m": {"type": "number", "exclusiveMinimum": 0}, "bone_fractions": {"type": "array", "minItems": 1}}},
    "gait": {"type": "object", "required": ["hint", "frequency_hz", "amplitude_deg", "chain_lag_rad", "bob_m"], "properties": {"hint": {"type": "string"}, "frequency_hz": {"type": "number", "exclusiveMinimum": 0}, "amplitude_deg": {"type": "number"}, "chain_lag_rad": {"type": "number"}, "bob_m": {"type": "number"}}}
  }
}
